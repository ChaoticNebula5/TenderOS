# B17 Phase 0: the ONE definition of the backend test environment, read by
# both the Makefile's `test` target and scripts/test-backend.ps1, so it is
# never retyped. Plain KEY=VALUE lines only (no quotes, no spaces) - both
# readers parse it that way.
#
# POSTGRES_DSN must end in _test: tests/integration/conftest.py refuses any
# other database, and test-backend.ps1 refuses before pytest even starts.
# REDIS_URL is database 1: the running stack's RQ queues use database 0.
# Hostnames are localhost because pytest runs on the host, where the
# containers' internal names (postgres, redis, neo4j, minio) don't resolve.
POSTGRES_DSN=postgresql+asyncpg://tenderos:changeme@localhost:5432/tenderos_test
REDIS_URL=redis://localhost:6379/1
NEO4J_URI=bolt://localhost:7687
S3_ENDPOINT_URL=http://localhost:9000
RATE_LIMIT_ENABLED=false
