# B17 Phase 0: the ONE definition of the backend test environment, read by
# both the Makefile's `test` target and scripts/test-backend.ps1, so it is
# never retyped. Plain KEY=VALUE lines only (no quotes, no spaces) - both
# readers parse it that way.
#
# POSTGRES_DSN must end in _test: tests/integration/conftest.py refuses any
# other database, and test-backend.ps1 refuses before pytest even starts.
# REDIS_URL is database 1: the running stack's RQ queues use database 0.
# Hosts are the loopback address because pytest runs on the host, where the
# containers' internal names (postgres, redis, neo4j, s3) don't resolve.
# 127.0.0.1, not localhost (plan item 47): localhost tries ::1 first, and on
# the Windows dev host a connection to Docker on ::1 can hang 21 s before it
# falls back (2026-11-05: this suite's idempotency file took 874 s against 75 s).
POSTGRES_DSN=postgresql+asyncpg://tenderos:changeme@127.0.0.1:5433/tenderos_test
REDIS_URL=redis://127.0.0.1:6379/1
NEO4J_URI=bolt://127.0.0.1:7687
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Test uploads go to their own bucket, the same one CI uses (ci.yml's test
# job). Without this, pytest fell back to .env's S3_BUCKET - the app bucket -
# and every local run left its uploads there. ObjectStorage creates the
# bucket on first use, so a fresh store needs no setup.
S3_BUCKET=tenderos-ci
RATE_LIMIT_ENABLED=false
# B17 Phase 0b: tests never use the real provider. Without these, pytest
# inherited LLM_PROVIDER and the real Gemini keys from the untracked .env,
# so a test that ever reached the real client would have spent real money.
# Blank keys make such a call fail instead. Same in CI (ci.yml sources this).
LLM_PROVIDER=fake
GEMINI_API_KEY=
COMPLIANCE_GEMINI_API_KEY=
TALENT_GEMINI_API_KEY=
COMMERCIAL_GEMINI_API_KEY=
