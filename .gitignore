# Internal planning/spec docs — not part of the public repo
/CLAUDE.md
AGENTS.md
/TenderOS-PRD.md
/TenderOS-Build-Guide.md

# Secrets
.env
.env.*
!.env.example

# Private tender data — never enters version control or CI
data_private/*
!data_private/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
dist/
build/
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
.playwright-mcp/

# Playwright test runner output (apps/web/e2e/ - screenshots, traces, HTML
# report per run; regenerated by `npm run test:e2e`, never source)
apps/web/test-results/
apps/web/playwright-report/

# Live-run Postgres dumps (B16) - preserved evidence from a real,
# billed pipeline run, never source; see KNOWN_LIMITATIONS.md's own
# test-teardown-trap history for why these get pg_dump'd immediately
# and kept out of git rather than committed.
/backups/

# Generated synthetic fixtures (B4). Reproduced deterministically by
# scripts/make_synthetic_fixtures.py, which IS committed - keeping the
# binaries out keeps the repo diffable and avoids any chance of real tender
# content being mistaken for a fixture (A5.1).
data/synthetic/*.pdf
data/synthetic/*.docx
data/synthetic/*.xlsx

# B5's synthetic ground-truth package (scripts/synthetic_tender_a.py) - same
# reasoning, one level deeper. data/ground_truth/*.jsonl is NOT ignored: the
# JSONL files are the actual eval labels (Part L2), small and diffable, and
# are committed like any other test fixture/expected-output file - only the
# generated document binaries are regenerated-not-committed.
data/synthetic/tender_a/*.pdf
data/synthetic/tender_a/*.docx
data/synthetic/tender_a/*.xlsx
