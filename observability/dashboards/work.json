      "type": "timeseries",
      "title": "Jobs waiting per queue",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tenderos_rq_queue_jobs",
          "legendFormat": "{{queue}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
