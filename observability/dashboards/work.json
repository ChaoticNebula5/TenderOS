          "legendFormat": "run {{status}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tenderos_operation_oldest_age_seconds",
          "legendFormat": "operation {{status}}",
          "range": true,
          "instant": false,
