{
  "uid": "tenderos-work",
  "title": "TenderOS: Work",
  "description": "Is work stuck, and where: queues, runs, operations, dead letters, and the rows behind each number.",
  "tags": [
    "tenderos"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
