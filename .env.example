# Copy to .env and fill in real values. Never commit .env.

APP_ENV=local
APP_SECRET_KEY=changeme
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# Hostnames below are Docker Compose service names — the app always runs
# inside the compose network (see B1 "do not proceed if" gate: no service
# runs directly on the host). Ports are still published on loopback for
# host-side tooling (psql, a Neo4j browser, an S3 client), see compose file.
POSTGRES_USER=tenderos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tenderos
POSTGRES_DSN=postgresql+asyncpg://tenderos:changeme@postgres:5432/tenderos
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

S3_ENDPOINT_URL=http://s3:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=tenderos
S3_REGION=us-east-1

# B5: first real adapter is Gemini, not Anthropic - this project's own call
# (free-tier availability), flagged since A2's table names Anthropic as the
# example first adapter. LLMClient stays provider-neutral at the interface
# level; a later Anthropic/OpenAI adapter is a new file, not a change here.
#
# B17: LLM_PROVIDER is real again (KNOWN_LIMITATIONS.md's own "settings.
# llm_provider is dead configuration" entry - deleted in B16, actually
# wired in B17). "gemini" (default, real provider) everywhere except a
# deliberate local/E2E opt-in to "fake" (FakeLLMClient, scripted/fallback
# responses, zero cost, zero network). core/config.py refuses to start at
# all if LLM_PROVIDER=fake and APP_ENV=production together - never set
# this in a real deployment.
#
# Phase 4 plan item 46: the compose stack does not read this line or the
# Gemini keys below for the api, the four workers and the outbox
# dispatcher. docker-compose.yml sets LLM_PROVIDER=fake with blank keys,
# whatever this file says; only scripts/real-stack.ps1, through
# docker-compose.live.yml, sets gemini and takes the keys from here. This
# line still applies to processes that read .env directly on the host,
# such as scripts/run_eval.py.
LLM_PROVIDER=gemini
GEMINI_API_KEY=changeme
PLANNER_MODEL=changeme
# Verified live against a real account during B5's Docker smoke test and
# eval-gate run (Part P) - and re-verified after the account's own rate-limit
# dashboard (aistudio.google.com/rate-limit) showed WHY the first two
# attempts failed:
#   1. gemini-2.5-flash/-flash-lite: 404, "no longer available to new users"
#      - still listed by models.list, but unusable on this account.
#   2. gemini-flash-latest/-flash-lite-latest: resolved to gemini-3.6-flash,
#      which the dashboard showed capped at 20 requests/DAY on this account's
#      free tier - nowhere near enough for a real multi-document extraction
#      run (batches + one verification call per mandatory item).
# The dashboard's actual pattern: full "Flash" models cap at 20 RPD, but
# "Flash Lite" variants cap at 500 RPD on this account - explicit dated Lite
# model IDs instead of "-latest" aliases, trading the aliases' auto-update
# convenience for both a much higher quota AND reproducibility (behavior
# won't shift under a Google-side alias update). Deliberately DIFFERENT Lite
# models for extractor vs. verifier, not the same one twice: each model ID
# tracks its own independent 500 RPD quota, so splitting the two roles
# across two models doubles the effective daily budget rather than both
# roles competing for one shared 500/day pool.
EXTRACTOR_MODEL=gemini-3.1-flash-lite
VERIFIER_MODEL=gemini-3.5-flash-lite
REASONING_MODEL=changeme
WRITER_MODEL=changeme
CRITIC_MODEL=changeme

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=20
RERANK_TOP_N=10

GRAPH_MAX_HOPS=4

# At least 32 bytes in every environment (decision 0042): the api, the
# workers and migrations refuse to start with a shorter key, so this
# placeholder must be replaced. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With APP_ENV=production they also refuse a localhost or plain-http
# WEB_BASE_URL, "changeme" model names and credentials, rate limiting off,
# and the E2E rate-limit bypass on.
JWT_SIGNING_KEY=changeme
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Observability profile only (docker compose --profile observability up).
# Real dashboards land in B17; local/throwaway credentials until then.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
