# Copy to .env and fill in real values. Never commit .env.

APP_ENV=local
APP_SECRET_KEY=changeme
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# Hostnames below are Docker Compose service names — the app always runs
# inside the compose network (see B1 "do not proceed if" gate: no service
# runs directly on the host). Ports are still published to localhost for
# host-side tooling (psql, a Neo4j browser, an S3 client), see compose file.
POSTGRES_USER=tenderos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tenderos
POSTGRES_DSN=postgresql+asyncpg://tenderos:changeme@postgres:5432/tenderos
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=tenderos
S3_REGION=us-east-1

LLM_PROVIDER=anthropic
PLANNER_MODEL=changeme
EXTRACTOR_MODEL=changeme
VERIFIER_MODEL=changeme
REASONING_MODEL=changeme
WRITER_MODEL=changeme
CRITIC_MODEL=changeme

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5

GRAPH_MAX_HOPS=4
MAX_PROPOSAL_REVISIONS=2
MAX_AGENT_RETRIES=3
MAX_TENDER_COST_USD=25

JWT_SIGNING_KEY=changeme
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Observability profile only (docker compose --profile observability up).
# Real dashboards land in B17; local/throwaway credentials until then.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
